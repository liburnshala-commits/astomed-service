{
  "name": "Customer",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "F\u00f6retagsnamn"
    },
    "org_number": {
      "type": "string",
      "description": "Organisationsnummer"
    },
    "address": {
      "type": "string",
      "description": "Adress"
    },
    "postal_code": {
      "type": "string",
      "description": "Postnummer"
    },
    "city": {
      "type": "string",
      "description": "Stad"
    },
    "contact_person": {
      "type": "string",
      "description": "Referensperson"
    },
    "email": {
      "type": "string",
      "description": "E-post"
    },
    "phone": {
      "type": "string",
      "description": "Telefon"
    },
    "portal_token": {
      "type": "string",
      "description": "Unik token f\u00f6r kundportal"
    },
    "notes": {
      "type": "string",
      "description": "Anteckningar"
    },
    "is_imported": {
      "type": "boolean",
      "default": false,
      "description": "Importerad via CSV-import"
    },
    "has_added_machine_via_import": {
      "type": "boolean",
      "default": false,
      "description": "Har f\u00e5tt maskin tillagd via import"
    },
    "is_invited": {
      "type": "boolean",
      "default": false,
      "description": "Kund \u00e4r inbjuden till portalen"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "Markerad f\u00f6r radering (GDPR)"
    },
    "deleted_date": {
      "type": "string",
      "format": "date-time",
      "description": "Datum n\u00e4r kunden markerades f\u00f6r radering"
    },
    "reminder_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Automatisk servicep\u00e5minnelse aktiverad"
    },
    "reminder_days_before": {
      "type": "number",
      "default": 60,
      "description": "Antal dagar innan f\u00f6rfall som p\u00e5minnelse skickas"
    },
    "documents": {
      "type": "array",
      "description": "Uppladdade dokument (t.ex. avtal, PDF)",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "insurance_partner": {
      "type": "string"
    },
    "insurance_policy_status": {
      "type": "string"
    },
    "saker_klinik_enrolled": {
      "type": "boolean",
      "default": false
    },
    "academy_access_granted": {
      "type": "boolean",
      "default": false
    },
    "academy_tier": {
      "type": "string"
    },
    "academy_synced_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "company_name"
  ]
}