{
  "name": "MethodDescription",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Namn p\u00e5 metoden/behandlingen"
    },
    "description": {
      "type": "string",
      "description": "Syfte / Kort beskrivning av metoden"
    },
    "principles": {
      "type": "string",
      "description": "Principer f\u00f6r metoden"
    },
    "indications": {
      "type": "string",
      "description": "Indikationer (Vem \u00e4r l\u00e4mplig?)"
    },
    "contraindications": {
      "type": "string",
      "description": "Kontraindikationer"
    },
    "pre_visit_instructions": {
      "type": "string",
      "description": "Inf\u00f6r kundbes\u00f6ket"
    },
    "arrival_procedure": {
      "type": "string",
      "description": "Vid kundens ankomst"
    },
    "consent_and_info": {
      "type": "string",
      "description": "Informationsgivning & Samtycke"
    },
    "skin_assessment": {
      "type": "string",
      "description": "Hudbed\u00f6mning / Patchtest"
    },
    "equipment_check": {
      "type": "string",
      "description": "Kontroll av utrustning"
    },
    "hygiene_routines": {
      "type": "string",
      "description": "Hygienrutiner"
    },
    "authorized_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Vilka personer som ska utf\u00f6ra varje enskilt moment"
    },
    "required_competence": {
      "type": "string",
      "description": "N\u00f6dv\u00e4ndig kompetens"
    },
    "step_by_step_instructions": {
      "type": "string",
      "description": "Steg-f\u00f6r-steg-instruktioner"
    },
    "equipment_settings": {
      "type": "string",
      "description": "Utrustningsinst\u00e4llningar"
    },
    "exposure_times": {
      "type": "string",
      "description": "Exponeringstider"
    },
    "staff_protective_equipment": {
      "type": "string",
      "description": "Skyddsutrustning f\u00f6r personal"
    },
    "customer_protective_equipment": {
      "type": "string",
      "description": "Skyddsutrustning f\u00f6r kund"
    },
    "risk_assessment": {
      "type": "string",
      "description": "Riskbed\u00f6mning under behandlingen"
    },
    "immediate_aftercare": {
      "type": "string",
      "description": "Omedelbar efterv\u00e5rd"
    },
    "aftercare_info": {
      "type": "string",
      "description": "Information om efterv\u00e5rd (till kund)"
    },
    "documentation_routines": {
      "type": "string",
      "description": "Dokumentation i journal"
    },
    "cleaning_routines": {
      "type": "string",
      "description": "St\u00e4dning och desinfektion"
    },
    "risks_and_side_effects": {
      "type": "string",
      "description": "Risker och m\u00f6jliga biverkningar"
    },
    "emergency_actions": {
      "type": "string",
      "description": "\u00c5tg\u00e4rder vid biverkningar/skada"
    },
    "clinic_id": {
      "type": "string",
      "description": "Klinikens/Kundens ID"
    },
    "is_routine": {
      "type": "boolean",
      "default": false,
      "description": "Om detta \u00e4r en allm\u00e4n rutin ist\u00e4llet f\u00f6r en specifik metod"
    }
  },
  "required": [
    "title",
    "clinic_id"
  ]
}